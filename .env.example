# ---------------------------------------------------------------------------
# FarmWard Environment Configuration
# ---------------------------------------------------------------------------

# Authentication Secret (REQUIRED in production)
# Must be a long, randomly generated secret (e.g. openssl rand -base64 32).
# If omitted in production, the application will emit a security warning and
# sessions will use an insecure development-only fallback key.
AUTH_SECRET=replace-with-a-long-random-secret

# Database File Path (Optional)
# Absolute path to the SQLite database file.
# Defaults to `data/farm-portal.sqlite` locally and `/tmp/farm-portal.sqlite` on Vercel.
# Vercel's temporary filesystem lets the demo run but resets data between instances or deployments.
# Use a managed database for persistent production records.
# DATABASE_PATH=/var/data/farm-portal.sqlite

# Node Environment (Optional, set by deployment platform)
# NODE_ENV=production
